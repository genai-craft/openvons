# openvons (open-Jev) の環境変数の例。scripts/*.sh が読む
OPENVONS_STATE=./state            # 実体のコピー・担当範囲・TTS キャッシュ・収集した発話・ログ (gitignore 済み)
OPENVONS_DATA=./data              # 外部データの置き場 (station_database の CSV など)
JEV_APP=examples.stations.app     # デモのアプリモジュール
JEV_TTS_URL=voicevox://127.0.0.1:50021   # 事前学習の TTS。irodori://host:8093 / openai://host:port/v1?model=...&voice=... も可
JEV_DUMP_UTTS=1                   # マイク発話を state/<app>/utts/ に保存 (実測・再校正用)
# JEV_SSL_DIR=./ssl               # cert.pem/key.pem を置くと https で上げる (マイクは https か localhost が必須)
# HF_HOME=~/.cache/huggingface    # モデルの置き場
